# ==========================================
# GitForge Environment Configuration
# ==========================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# PostgreSQL Database Connection (Neon, Supabase, Cloud SQL, or local Docker container)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Cloudflare 1-Click OAuth 2.0 Integration (Optional - can also configure via Admin Console)
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
CLOUDFLARE_OAUTH_SCOPES=account:read pages:edit dns:edit

# S3-Compatible Cloud Storage (Optional - Backblaze B2, AWS S3, Cloudflare R2, MinIO)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

