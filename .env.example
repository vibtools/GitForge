# ==============================================================================
# GitForge — Multi-Account Cloudflare Pages Fleet Orchestrator
# ==============================================================================

# Database Connection (Neon Serverless PostgreSQL or any standard PostgreSQL instance)
DATABASE_URL="postgresql://username:password@ep-example-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Server Port & Mode
PORT=3000
NODE_ENV="production"

# Application Base URL (Auto-configured in deployment environments)
APP_URL="http://localhost:3000"

# Optional Gemini AI API Key (If AI extensions are enabled)
GEMINI_API_KEY=""

# S3 / Backblaze B2 Storage Configuration
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="gitforgedev"
S3_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
S3_REGION="us-west-004"
